<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- This skin is at github.com/OpenViX/enigma2/tree/master/data/display480 -->
<skin>
	<windowstyle id="1" type="skinned">
		<color color="#000000" name="Background"/>
		<color color="#ffffff" name="LabelForeground"/>
		<color color="#000000" name="ListboxBackground"/>
		<color color="#ffffff" name="ListboxForeground"/>
		<color color="#000000" name="ListboxSelectedBackground"/>
		<color color="#ffffff" name="ListboxSelectedForeground"/>
		<color color="#000000" name="ListboxMarkedBackground"/>
		<color color="#ffffff" name="ListboxMarkedForeground"/>
		<color color="#000000" name="ListboxMarkedAndSelectedBackground"/>
		<color color="#ffffff" name="ListboxMarkedAndSelectedForeground"/>
		<color color="#ffffff" name="WindowTitleForeground"/>
		<color color="#000000" name="WindowTitleBackground"/>
	</windowstyle>
<!-- Define colors -->
	<colors>
		<!-- pick unique names for the colours to not conflict with the GUI skin -->
		<color name="FdLcdTitleForeground" value="#ffff00" /><!-- Yellow -->
		<color name="FdLcdTitleForegroundOther" value="#7fffff" /><!-- LightCyan -->
		<color name="FdLcdHalfShade" value="#888888" /><!-- gray -->
		<color name="FdLcdRecordState" value="#ff0000" /><!-- red -->
	</colors>

	<fonts>
		<!-- pick a unique name for the font to not conflict with the GUI skin -->
		<font filename="nmsbd.ttf" name="FdLcD" scale="100"/>
	</fonts>

<!-- template -->
	<screen name="SummaryClockPanel">
		<widget source="global.CurrentTime" render="Label" position="e-180,260" size="160,60" font="FdLcD;40" halign="right" valign="center" noWrap="1">
			<convert type="ClockToText"></convert>
		</widget>
	</screen>

	<screen name="Colored_Clock_Panel">
		<widget source="global.CurrentTime" render="Label" position="140,255" size="200,60" halign="center" font="FdLcD;55" foregroundColor="FdLcdTitleForeground">
			<convert type="ClockToText"></convert>
		</widget>
	</screen>

	<screen name="Parent_Title">
		<widget source="parent.title" render="Label" position="0,5" size="480,60" font="FdLcD;50" halign="center" valign="center" foregroundColor="FdLcdTitleForeground" />
	</screen>

	<screen name="TunerPanel">
		<eLabel text="TUNER:" position="20,260" size="155,60" valign="center" font="FdLcD;40"/>
		<widget source="session.FrontendInfo" render="Label" position="175,260" size="110,60" font="FdLcD;40" valign="center">
			<convert type="FrontendInfo">USE_TUNERS_STRING</convert>
		</widget>
	</screen>

	<screen name="RecordIconPanel">
		<widget source="session.RecordState" render="Pixmap" pixmap="record.png" position="300,275" size="30,30" zPosition="3" alphatest="blend">
			<convert type="ConfigEntryTest">config.usage.blinking_rec_symbol_during_recording,True,CheckSourceBoolean</convert>
			<convert type="ConditionalShowHide">Blink</convert>
		</widget>
		<widget source="session.RecordState" render="Pixmap" pixmap="record.png" position="300,275" size="30,30" zPosition="3" alphatest="blend">
			<convert type="ConfigEntryTest">config.usage.blinking_rec_symbol_during_recording,False,CheckSourceBoolean</convert>
			<convert type="ConditionalShowHide" />
		</widget>
	</screen>

<!-- main -->
	<!-- menus -->
	<screen name="MenuSummary" position="fill" resolution="480,320">
		<panel name="Parent_Title" />
		<widget source="parent.menu" render="Label" position="0,65" size="480,85" font="FdLcD;40" halign="center" valign="center">
			<convert type="StringListSelection" />
