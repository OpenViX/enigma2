<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- This skin is at github.com/OpenViX/enigma2/tree/master/data/display480 -->
<skin>
	<include filename="skin_display.xml"/>
	<colors>
		<!-- pick unique names for the colours to not conflict with the GUI skin -->
		<color name="FdLcdTitleForeground" value="#87cefa" />
	</colors>

<!-- template -->
	<screen name="SummaryClockPanelTopRight">
		<widget source="global.CurrentTime" render="Label" position="e-180,10" size="160,40" font="FdLcD;40" halign="right" valign="center" noWrap="1">
			<convert type="ClockToText"></convert>
		</widget>
	</screen>
<!-- Rec Panel -->
	<screen name="RecordIconPanelTopRight">
		<widget source="session.RecordState" render="Pixmap" pixmap="record.png" position="e-100,70" size="60,60" zPosition="3" alphatest="blend" scale="1">
			<convert type="ConfigEntryTest">config.usage.blinking_rec_symbol_during_recording,True,CheckSourceBoolean</convert>
			<convert type="ConditionalShowHide">Blink</convert>
		</widget>
		<widget source="session.RecordState" render="Pixmap" pixmap="record.png" position="e-100,70" size="60,60" zPosition="3" alphatest="blend" scale="1">
			<convert type="ConfigEntryTest">config.usage.blinking_rec_symbol_during_recording,False,CheckSourceBoolean</convert>
			<convert type="ConditionalShowHide" />
		</widget>
	</screen>
<!-- channelselection -->
	<screen name="ChannelSelectionSummary" position="0,0" size="480,320">
		<widget source="parent.Service" render="LcdPicon" position="20,0" size="284,170" zPosition="2" alphatest="blend">
			<convert type="ServiceName">Reference</convert>
		</widget>
		<widget source="parent.ServiceEvent" render="Label" position="20,170" size="440,50" font="FdLcD;40" halign="center" valign="center" nowrap="1">
			<convert type="EventName">Name</convert>
		</widget>
		<widget source="parent.ServiceEvent" render="Progress" position="20,230" size="440,20" borderWidth="1" >
			<convert type="EventTime">Progress</convert>
		</widget>
		<widget source="parent.ServiceEvent" render="Label" position="e-275,260" size="130,40" font="FdLcD;40" halign="center" valign="center" foregroundColor="FdLcdTitleForeground">
			<convert type="EventTime">StartTime</convert>
			<convert type="ClockToText">Format:%H:%M</convert>
		</widget>
		<widget source="parent.ServiceEvent" render="Label" position="e-145,260" size="130,40" font="FdLcD;40" halign="center" valign="center" foregroundColor="FdLcdTitleForeground">
			<convert type="EventTime">EndTime</convert>
			<convert type="ClockToText">Format: - %H:%M</convert>
		</widget>
		<widget source="parent.ServiceEvent" render="Label" position="20,260" size="200,40" font="FdLcD;40" valign="center" foregroundColor="FdLcdTitleForeground">
			<convert type="EventTime">Remaining</convert>
			<convert type="RemainingToText">VFD</convert>
		</widget>
		<panel name="SummaryClockPanelTopRight" />
		<panel name="RecordIconPanelTopRight" />
	</screen>
	<screen name="EPGSelectionSummary" position="0,0" size="480,320">
		<widget source="parent.Service" render="LcdPicon" position="20,0" size="284,170" zPosition="2" alphatest="blend">
			<convert type="ServiceName">Reference</convert>
		</widget>
		<widget source="parent.Event" render="Label" position="20,170" size="440,50" font="FdLcD;40" halign="center" valign="center" nowrap="1">
			<convert type="EventName">Name</convert>
		</widget>
		<widget source="parent.Event" render="Progress" position="20,230" size="440,20" borderWidth="1" >
			<convert type="EventTime">Progress</convert>
		</widget>
		<widget source="parent.Event" render="Label" position="e-275,260" size="130,40" font="FdLcD;40" halign="center" valign="center" foregroundColor="FdLcdTitleForeground">
			<convert type="EventTime">StartTime</convert>
			<convert type="ClockToText">Format:%H:%M</convert>
		</widget>
		<widget source="parent.Event" render="Label" position="e-145,260" size="130,40" font="FdLcD;40" halign="center" valign="center" foregroundColor="FdLcdTitleForeground">
			<convert type="EventTime">EndTime</convert>
			<convert type="ClockToText">Format: - %H:%M</convert>
		</widget>
		<widget source="parent.Event" render="Label" position="20,260" size="200,40" font="FdLcD;40" valign="center" foregroundColor="FdLcdTitleForeground">
			<convert type="EventTime">Remaining</convert>
			<convert type="RemainingToText">VFD</convert>
		</widget>
		<panel name="SummaryClockPanelTopRight" />
		<panel name="RecordIconPanelTopRight" />
	</screen>
	<screen name="InfoBarSummary" position="0,0" size="480,320">
		<widget source="session.CurrentService" render="LcdPicon" position="20,0" size="284,170" zPosition="2" alphatest="blend">
			<convert type="ServiceName">Reference</convert>
		</widget>
		<widget source="session.Event_Now" render="Label" position="20,170" size="440,50" font="FdLcD;40" halign="center" valign="center" nowrap="1">
			<convert type="EventName">Name</convert>
		</widget>
		<widget source="session.Event_Now" render="Progress" position="20,230" size="440,20" borderWidth="1" >
			<convert type="EventTime">Progress</convert>
		</widget>
		<widget source="session.Event_Now" render="Label" position="e-275,260" size="130,40" font="FdLcD;40" halign="center" valign="center" foregroundColor="FdLcdTitleForeground">
			<convert type="EventTime">StartTime</convert>
			<convert type="ClockToText">Format:%H:%M</convert>
		</widget>
		<widget source="parent.session.Event_Now" render="Label" position="e-145,260" size="130,40" font="FdLcD;40" halign="center" valign="center" foregroundColor="FdLcdTitleForeground">
			<convert type="EventTime">EndTime</convert>
			<convert type="ClockToText">Format: - %H:%M</convert>
		</widget>
		<widget source="session.Event_Now" render="Label" position="20,260" size="200,40" font="FdLcD;40" valign="center" foregroundColor="FdLcdTitleForeground">
			<convert type="EventTime">Remaining</convert>
			<convert type="RemainingToText">VFD</convert>
		</widget>
		<panel name="SummaryClockPanelTopRight" />
		<panel name="RecordIconPanelTopRight" />
	</screen>
</skin>
